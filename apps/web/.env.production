# Defaults do build de produção (Vercel). Enquanto a API .NET não existe, o app roda 100% com o mock (MSW).
# Para ligar o backend real: defina NEXT_PUBLIC_API_MOCKING=false e NEXT_PUBLIC_API_URL no painel da Vercel
# (variáveis do painel têm prioridade sobre este arquivo).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_MOCKING=true
# NEXT_PUBLIC_SITE_URL é opcional: sem ela, usamos a URL da Vercel (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
