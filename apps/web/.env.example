# URL base da API REST (.NET). Relativa em dev (proxy abaixo); absoluta em produção: https://api.seudominio.com/api
NEXT_PUBLIC_API_URL=/api

# true = intercepta chamadas com MSW (Mock Service Worker) usando as fixtures em src/mocks
# false = fala com a API .NET (apps/api). Defina também API_PROXY_URL ou NEXT_PUBLIC_API_URL absoluta.
NEXT_PUBLIC_API_MOCKING=true

# Encaminha /api/* para o backend .NET pela mesma origem (só quando NEXT_PUBLIC_API_MOCKING=false)
# API_PROXY_URL=http://localhost:5210

# URL pública do site (usada em metadata, sitemap e robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Public key do Mercado Pago (tokeniza o cartão no navegador). Sem ela, fora do mock, o cartão fica indisponível.
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client ID OAuth do Google Identity Services (botão "Continuar com Google"). Sem ele, fora do mock, o botão some.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=0000000000-xxxxxxxx.apps.googleusercontent.com

# true = registra o service worker também em `next dev` (padrão: só em produção)
# NEXT_PUBLIC_SW_DEV=false

# Taxa (0–1) de erros 500 aleatórios nas listagens do mock, para testar estados de erro (padrão 0.03)
# NEXT_PUBLIC_MOCK_ERROR_RATE=0.03
