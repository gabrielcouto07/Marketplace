# URL base da API REST (.NET). Relativa em dev (proxy abaixo); absoluta em produção: https://api.seudominio.com/api
NEXT_PUBLIC_API_URL=/api

# true = intercepta chamadas com MSW (Mock Service Worker) usando as fixtures em src/mocks
# false = fala com a API .NET (apps/api). Defina também API_PROXY_URL ou NEXT_PUBLIC_API_URL absoluta.
NEXT_PUBLIC_API_MOCKING=true

# Encaminha /api/* para o backend .NET pela mesma origem (só quando NEXT_PUBLIC_API_MOCKING=false)
# API_PROXY_URL=http://localhost:5210

# URL pública do site (usada em metadata, sitemap e robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3210
