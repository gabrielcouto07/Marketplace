{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "SqlitePath": ".data/marketplace.dev.db",
    "InitializeOnStartup": true,
    "SeedDemoData": false
  },
  "Cors": {
    "Origins": [
      "http://localhost:3210"
    ]
  },
  "Links": {
    "SiteUrl": "http://localhost:3210",
    "ApiUrl": "http://localhost:5210/api",
    "TrackingUrlTemplates": {
      "correios": "https://rastreamento.correios.com.br/app/index.php?objetos={code}"
    },
    "DefaultTrackingUrlTemplate": "",
    "BoletoLinkDays": 10
  },
  "OpenApi": {
    "Enabled": false
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "PasswordResetMinutes": 60,
    "MinPasswordLength": 8,
    "Jwt": {
      "Issuer": "marketplace-py",
      "Audience": "marketplace-py-web",
      "Secret": "",
      "AccessTokenMinutes": 60
    },
    "Google": {
      "ClientId": ""
    }
  },
  "Payments": {
    "Provider": "Fake",
    "AllowFakeOutsideDevelopment": false,
    "Fake": {
      "AutoApproveAfterSeconds": 0,
      "DeclinedLast4": "0000",
      "WebhookSecret": ""
    },
    "MercadoPago": {
      "BaseUrl": "https://api.mercadopago.com",
      "AccessToken": "",
      "WebhookSecret": "",
      "NotificationUrl": "",
      "BoletoMethodId": "bolbradesco",
      "StatementDescriptor": "MKTPY",
      "RequireSignature": true,
      "SignatureToleranceMinutes": 10
    }
  },
  "Shipping": {
    "Provider": "Table",
    "FallbackToTable": true,
    "TimeoutSeconds": 8
  },
  "PostalCodes": {
    "CacheHours": 24,
    "AllowOfflineFallback": false
  },
  "Tracking": {
    "Provider": "None",
    "PollIntervalMinutes": 15,
    "PollBatchSize": 200,
    "FakeStepMinutes": 2,
    "WebhookSecret": ""
  },
  "ExchangeRates": {
    "Provider": "Manual",
    "RefreshIntervalMinutes": 60,
    "ValidityHours": 24,
    "Pairs": ["BRL:PYG", "PYG:BRL", "USD:BRL"]
  },
  "RemessaConforme": {
    "JobIntervalMinutes": 10,
    "Platform": {
      "Brand": "Mercado Paraguai",
      "TradeName": "Mercado Paraguai",
      "LegalName": "",
      "DocumentType": "CNPJ",
      "Document": "",
      "Country": "BR",
      "AddressLine": "",
      "AdeNumber": "",
      "OperatorCode": "",
      "OperatorName": ""
    },
    "Carrier": {
      "Provider": "Sandbox",
      "AllowSandboxOutsideDevelopment": false,
      "BaseUrl": "",
      "ApiKey": "",
      "ApiKeyHeader": "Authorization",
      "ApiKeyScheme": "Bearer",
      "ShipmentsPath": "/v1/remessas",
      "CancelPathTemplate": "/v1/remessas/{reference}",
      "RemittancesPath": "/v1/tributos/repasses",
      "CarrierName": "Operador logístico",
      "TimeoutSeconds": 25
    }
  },
  "Siscomex": {
    "BaseUrl": "https://val.portalunico.siscomex.gov.br",
    "AuthPath": "/portal/api/autenticar/chave-acesso",
    "RemxPath": "/remx/api/ext",
    "ClientId": "",
    "ClientSecret": "",
    "RoleType": "EMPRCOMEL",
    "Cnpj": "",
    "SyncIntervalMinutes": 60,
    "LookbackDays": 45,
    "MaxShipmentsPerQuery": 200,
    "OccurrenceMap": {},
    "TimeoutSeconds": 30
  },
  "Serpro": {
    "BaseUrl": "https://gateway.apiserpro.serpro.gov.br",
    "TokenPath": "/token",
    "CpfPath": "/consulta-cpf-df/v3/cpf/{cpf}",
    "ConsumerKey": "",
    "ConsumerSecret": "",
    "CacheHours": 24,
    "TimeoutSeconds": 10
  },
  "Ncm": {
    "Source": "Siscomex",
    "Url": "https://portalunico.siscomex.gov.br/classif/api/publico/nomenclatura/download/json?perfil=PUBLICO",
    "CachePath": ".data/ncm.json",
    "RefreshHours": 24
  },
  "Ptax": {
    "Provider": "bcb-ptax",
    "BaseUrl": "https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata",
    "RefreshIntervalMinutes": 180,
    "ValidityHours": 96
  },
  "Housekeeping": {
    "IntervalMinutes": 60,
    "QuoteRetentionHours": 24,
    "TokenRetentionDays": 7,
    "WebhookRetentionDays": 90
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": ".data/media",
    "MaxUploadBytes": 8388608,
    "R2": {
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Bucket": "",
      "PublicBaseUrl": "",
      "PresignMinutes": 15
    }
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@marketplacepy.com",
    "FromName": "Marketplace PY"
  },
  "Privacy": {
    "DataControllerEmail": "privacidade@marketplacepy.com",
    "AccountDeletionConfirmation": "EXCLUIR MINHA CONTA"
  },
  "DataProtection": {
    "KeysPath": ".data/keys"
  },
  "Admin": {
    "Email": "",
    "Password": "",
    "FullName": "Administrador"
  }
}
